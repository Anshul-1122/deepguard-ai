# Copy this file to `.env` and fill in real values before running in production.

ENVIRONMENT=development
DEBUG=true

# Comma-values are parsed as a JSON list by pydantic-settings; simplest to
# just edit CORS_ORIGINS directly in app/config.py for custom domains.
JWT_SECRET_KEY=replace-with-a-long-random-secret-in-production

# Development default (SQLite). For production, use a Postgres URL, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/deepguard
DATABASE_URL=sqlite:///./deepguard.db
